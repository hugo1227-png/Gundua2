{
  "name": "gundua-rest-mysql",
  "version": "1.0.0-alpha.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "description": "GUNDUA university alpha: Node.js REST API + MySQL 8",
  "scripts": {
